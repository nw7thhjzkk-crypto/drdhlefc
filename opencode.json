{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/big-pickle",
  "small_model": "opencode/gpt-5-nano",
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "webfetch": "allow",
    "question": "deny",
    "doom_loop": "deny",
    "external_directory": {
      "*": "deny",
      "/home/runner/.npm/**": "allow",
      "/home/runner/.opencode/**": "allow",
      "/home/runner/.cache/**": "allow",
      "/home/runner/work/_temp/**": "allow",
      "/tmp/**": "allow"
    }
  }
}
